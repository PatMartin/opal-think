# OPAL dotenv example.
# Startup reads ./.env by default; real environment variables always win,
# including empty strings. Use --env-file PATH for another file, or
# --no-env-file to disable loading and initialization. Secret values stay
# local; this example is safe to commit.

# OPAL_THINK_CONFIG
#OPAL_THINK_CONFIG=<config.yaml>

# OPAL_THINK_HOST
#OPAL_THINK_HOST=127.0.0.1

# OPAL_THINK_PORT
#OPAL_THINK_PORT=8080

# OPAL_THINK_DB_PATH
#OPAL_THINK_DB_PATH=var/think.db

# OPAL_THINK_API_TOKEN
#OPAL_THINK_API_TOKEN=<optional-bearer-token>

# OPAL_THINK_API_URL
#OPAL_THINK_API_URL=http://127.0.0.1:8080

